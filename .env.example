# ——— Django ———
SECRET_KEY=gere-uma-chave-forte-com-openssl-rand-hex-32
DEBUG=False
LANGUAGE_CODE=pt-br
TIME_ZONE=America/Fortaleza

# ——— Hosts (sem protocolo) ———
ALLOWED_HOSTS=localhost,127.0.0.1,scale.seudominio.com,apiscale.seudominio.com

# ——— CORS/CSRF (com protocolo) ———
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://scale.seudominio.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://scale.seudominio.com

# ——— HTTPS Proxy ———
# Definir como true quando TLS é terminado em proxy externo (Cloudflare, LB)
DJANGO_HTTPS_PROXY=false

# ——— JWT lifetimes ———
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# ——— Postgres (Django) ———
DB_ENGINE=postgres
DB_NAME=scale
DB_USER=scale_user
DB_PASSWORD=TROQUE_ESTA_SENHA
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ——— Postgres (container oficial) ———
POSTGRES_DB=scale
POSTGRES_USER=scale_user
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ——— Redis ———
REDIS_PASSWORD=TROQUE_ESTA_SENHA
CELERY_BROKER_URL=redis://:TROQUE_ESTA_SENHA@redis:6379/0
CELERY_RESULT_BACKEND=redis://:TROQUE_ESTA_SENHA@redis:6379/0

# ——— App ———
APP_ENV=prod
AUDIT_ENABLED=true

# ——— Proxies confiáveis para auditoria de IP ———
# Lista de CIDRs separados por vírgula (ex: IP do Cloudflare, LB interno)
TRUSTED_PROXIES=

# ——— Email (SMTP) ———
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seuemail@seudominio.com
EMAIL_HOST_PASSWORD=TROQUE_ESTA_SENHA
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@seudominio.com

# ——— Alertas de backup ———
# CSV de e-mails que recebem alerta de falha de backup
BACKUP_ALERT_EMAILS=ti@seudominio.com

# ——— Banco HML (opcional) ———
DB_NAME_HML=scale_hml
DB_USER_HML=scale_hml
DB_PASSWORD_HML=TROQUE_ESTA_SENHA
DB_HOST_HML=db
DB_PORT_HML=5432

# ——— Admin URL (segurança por obscuridade) ———
# Ex: DJANGO_ADMIN_URL=meu-painel-secreto-xk39/
DJANGO_ADMIN_URL=admin/
